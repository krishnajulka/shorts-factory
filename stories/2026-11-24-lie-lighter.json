      ],
      "stickers": [{ "word": "taxes", "emoji": "💸" }]
    },
    {
      "id": "esc3",
      "text": "\"I will fix every road personally!\" Past the clock tower, past the birds, higher than church.",
      "setting": "city",
      "light": "dusk",
      "focus": "mayor",
      "speaker": "me",
      "effects": ["speed"],
