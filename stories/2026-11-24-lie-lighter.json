      "stickers": [{ "word": "never", "emoji": "😏" }]
    },
    {
      "id": "esc1",
      "text": "\"Free pizza for everyone!\" he promised, and his shoes left the ground. \"Just a breeze,\" he said.",
      "setting": "city",
      "light": "day",
      "focus": "mayor",
      "speaker": "me",
